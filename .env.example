# Prototype default (SQLite, zero setup):
# Local file is data/app.db (created by `npm run seed`).
# DATABASE_URL is reserved for a future Prisma/Postgres switch.
DATABASE_URL="file:./dev.db"

# Optional: override SQLite location (Render persistent disk, etc.)
# DATA_DIR="/var/data"
# DATABASE_PATH="/var/data/app.db"

# Production (PostgreSQL, see docker-compose.yml):
# DATABASE_URL="postgresql://rfid:rfid@localhost:5432/rfid_linen?schema=public"

JWT_SECRET="replace-with-a-long-random-string"
